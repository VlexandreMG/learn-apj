	<detail>
		<band height="709" splitType="Stretch">
			<textField>
				<reportElement x="20" y="349" width="515" height="45" uuid="ddbb7359-52a3-4f50-ae94-b2ced505e9e1"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      "+$F{sexe}+" "+$F{nomcomplet}+" est recruté(e) en qualité de "+$F{idfonction}+" et est classé (e) à la catégorie "+$F{idcategorie_paie}+" qualification "
+$F{idqualification}+" stipulée dans le Règlement du Personnel du Fonds Routier."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="475" width="515" height="38" uuid="8c1a990d-f456-49d4-b16e-45fc19c5beda"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      Les deux parties s’engagent à exécuter les obligations résultant du présent contrat, c’est-à-dire la prestation de travail du côté du salarié, et la prestation de salaire du côté de l’employeur."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="20" y="94" width="50" height="20" uuid="61dea708-43ac-4129-89ac-cc216ff708da"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Article 1 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="94" width="180" height="20" uuid="d7c7857c-da88-4850-bd6c-a7ddcab7e851"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Il a été conclu entre les soussignés :]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="146" width="380" height="16" uuid="2419639d-74fe-47e3-ab07-36f447917339"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[   et
]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="176" width="58" height="15" uuid="71522e08-47ba-4b4e-8157-686d0fa78755"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[$F{sexe}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="50" y="190" width="58" height="15" uuid="55f5632f-4618-4b50-853f-ea079b5d572a"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[né (e)  le :]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="208" width="58" height="15" uuid="c045b8c2-2162-49d8-b184-d0279dac582c"/>
