				<text><![CDATA[résidant à]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="226" width="201" height="15" uuid="f34b7e2d-e3cf-4382-b93e-31d05561ed62"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[titulaire de la Carte d’Identité Nationale n°]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="244" width="58" height="15" uuid="5b24809b-5c28-42c5-9e8c-fb9490c1ba22"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[délivrée le]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="266" width="515" height="73" uuid="a2adbd55-0dd8-44e4-ae0c-c920ee9106ca"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[            Nationalité Malagasy,
            qui déclare être libre de tout engagement,
                 désigné ci-après par le TRAVAILLEUR, d’autre part,
le présent Contrat de Travail dont les dispositions sont régies par la Loi n°094-029 du 25 août 1995 portant Code du Travail à Madagascar.
]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="349" width="50" height="15" uuid="752b1e49-14f9-43d6-a3e8-bf0cad530446"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Article 2 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="71" y="405" width="233" height="20" uuid="218073a9-c4b8-483f-8e55-5df51ee3c074"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Le lieu d’engagement est Antananarivo.]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="441" width="215" height="20" uuid="c9f00af3-c231-4305-aa03-099ad60ee49d"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[I -  EXECUTION DU CONTRAT]]></text>
			</staticText>
			<staticText>
				<reportElement x="185" y="51" width="200" height="20" uuid="d3bb3738-ffd7-4eba-981b-b401dd057e77"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[--------------------]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="618" width="183" height="20" uuid="7cf8972f-ee6e-46e6-b4d4-5947742b1036"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[II -  NATURE DU CONTRAT]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="645" width="50" height="20" uuid="c07bcdd8-3fa5-45d4-9fde-ceccc6137c59"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Article 4 :]]></text>
			</staticText>
			<textField>
				<reportElement x="20" y="665" width="346" height="20" uuid="68dfadac-5d3d-4108-afff-75a56b250275"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA["Il prend effet à compter du "+$F{datecontrat}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="20" y="71" width="70" height="20" uuid="950160d0-4a8c-4a66-a061-32608aecc409"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[MATRICULE :]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="71" width="70" height="20" uuid="3d482051-cfe8-46ff-b2f0-80757a287e23"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
					<font isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{matricule}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="78" y="175" width="430" height="15" uuid="461b12b5-b868-49c1-8a8c-b5eb24a5545d"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[" "+$F{nomcomplet}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="109" y="190" width="425" height="15" uuid="3da3e4db-4275-48aa-92a4-a971852e90f9"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[$F{date_naissance}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="109" y="208" width="425" height="15" uuid="3543cf3b-7f10-4266-88f6-ecd6c37bb3a5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[$F{adresse}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="251" y="226" width="283" height="15" uuid="9be3c32e-44a2-4a3f-9e97-0a04bda89144"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[$F{numero_cin}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="109" y="244" width="425" height="15" uuid="d1dc2a93-f2a7-4c21-aba2-25009aa31619"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none"/>
				<textFieldExpression><![CDATA[$F{date_cin}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="20" y="475" width="50" height="15" uuid="6de6f5f8-96dc-4b84-a002-0889486a2a1e"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Article 3 :]]></text>
			</staticText>
			<textField>
				<reportElement x="20" y="523" width="515" height="20" uuid="7f2709f2-8a74-4aab-abf0-c2ba584f9570"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["L’exécution du travail doit être personnelle, consciencieuse et loyale."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="554" width="515" height="48" uuid="496f5b0b-4f8f-4861-9bca-6a585629ed14"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA[$F{sexe}+" "+$F{nomcomplet}+" doit toute son activité professionnelle à l’employeur. "+$F{genre}+" s’interdit d’utiliser à son profit ou de divulguer les renseignements de nature confidentielle dont "+$F{genre}.toLowerCase()+" a eu connaissance au cours de son service. "]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="20" y="130" width="380" height="16" uuid="3c8c2503-61de-4d97-8ec1-47a39273d3b8"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[               désigné ci-après par l’EMPLOYEUR, d’une part,]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="114" width="80" height="16" uuid="933d48fb-47e5-44e2-9170-d59f95f6d9c5"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[- L'assurances
               désigné ci-après par l’EMPLOYEUR, d’une part,
   et
]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="114" width="65" height="16" uuid="b8f0c547-0320-476e-9cd7-5649b0ff630b"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[SOCOBIS,]]></text>
			</staticText>
			<staticText>
				<reportElement x="165" y="114" width="370" height="16" uuid="292bdaf3-4983-47b5-b32a-df19f21c588b"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[ représenté par son Directeur Général
]]></text>
			</staticText>
			<textField>
				<reportElement x="160" y="11" width="252" height="20" uuid="3fac835d-753a-4b8b-9c74-26cf67a81bcf"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["CONTRAT DE TRAVAIL N°"+$F{id}+" ("+$F{avenant}+")"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Opaque" x="69" y="648" width="295" height="20" uuid="56f1a65c-657b-4b9e-a19a-19ce53d38ee2"/>
				<textFieldExpression><![CDATA["Le présent contrat est établi pour une durée "+$F{typecontrat}+" ."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="187" y="31" width="198" height="20" uuid="427d4f50-e995-49b4-adfd-958eda558f89"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["(à durée " +
(($F{typecontrat} != null && $F{typecontrat}.equals("0")) ? "Indéterminée" : "Déterminée")
+ ")"]]></textFieldExpression>
			</textField>
		</band>
		<band height="720">
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="634" width="515" height="35" uuid="e6dba5fd-b279-4416-97c3-01832d381ccb"/>
				<box topPadding="4" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      "+$F{sexe}+" "+$F{nomcomplet}+" bénéficiera du régime de retraite prévu par la réglementation en vigueur."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="19" y="22" width="515" height="48" uuid="f1a1ed3a-fb23-4808-ab9d-c7297c7b67ab"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      A compter de la date d’effet du présent contrat,  "+$F{sexe}+" "+$F{nomcomplet}+" sera soumis (e) à une période d’essai dont la durée est fixée à " +$F{duree} +" mois, et renouvelable une fois. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="175" width="515" height="48" uuid="d4017acf-8c8f-4222-94db-9c92056f1fc7"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                       "+$F{sexe}+" "+$F{nomcomplet}+" percevra un salaire de base mensuel de "+$F{montantlettre}+" ( "+$F{montant}+" MGA)"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="337" width="515" height="48" uuid="972c58df-3e25-4dd0-a470-e33cac1f6dcc"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                       "+$F{sexe}+" "+$F{nomcomplet}+" aura droit au congé à raison de deux jours et demi par mois de service effectif, soit 30 (trente) jours calendaires par année de service. "]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="396" width="515" height="48" uuid="4f3c6953-4198-4a55-bb82-6a8f04a7af91"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      Pendant la durée de congé,  "+$F{sexe}+" "+$F{nomcomplet}+" percevra une allocation comprenant le salaire global de service y compris les indemnités et avantages perçus au cours de la période à l’exclusion des primes de rendement."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="497" width="515" height="48" uuid="2295e60f-e397-494f-92ea-013dc2ce132d"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      En cas d’accidents de travail ou de maladies professionnelles,  "+$F{sexe}+" "+$F{nomcomplet}+" sera assurée auprès  de la Caisse Nationale de Prévoyance Sociale (CNaPS) par les soins de l’Employeur."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="20" y="561" width="515" height="48" uuid="128a8082-138f-414b-9683-dd0706ac8304"/>
				<box topPadding="2" leftPadding="2" bottomPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="none"/>
				<textFieldExpression><![CDATA["                      "+$F{sexe}+" "+$F{nomcomplet}+" et sa famille bénéficient des soins et médicaments nécessaires au traitement des maladies prévus dans le Règlement du Personnel ou l’Accord d’Etablissement ou la Convention Collective du Fonds Routier.  "]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="19" y="84" width="511" height="35" uuid="26c81d71-8bac-4a81-9188-bc744b174edb"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Durant la période d’essai, les deux parties auront réciproquement la possibilité de résilier le présent contrat sans préavis et sans autre indemnité que celle compensatrice de congé payé au prorata du temps de service.]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="137" width="242" height="20" uuid="0dfe5b3a-aef1-4250-a6ff-00ba6c3f0f5b"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[III – CONDITIONS DE REMUNERATION]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="237" width="515" height="49" uuid="bb257f46-1dcd-46dd-afcb-9b6dff57c22d"/>
				<box topPadding="4" leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Top"/>
				<text><![CDATA[	     Des indemnités et des primes déterminées par le Règlement du Personnel ou l’Accord d’établissement ou Convention Collective sont allouées le cas échéant, au travailleur et suivant la catégorie professionnelle et les responsabilités	.]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="237" width="50" height="20" uuid="e7180094-7bd3-4409-8588-9345658d9df7"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Article 7 :]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="303" width="242" height="20" uuid="5c439bbb-7fdd-4b19-9be0-ebbc4799f8a0"/>
				<box leftPadding="5" rightPadding="5"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[IV – CONGE]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="337" width="50" height="20" uuid="d15b23c0-abf5-494c-8bd5-e06136a8a109"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
